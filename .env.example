# 复制为 .env 后填写。程序启动会自动读取，已有环境变量优先，勿提交真实密钥。
RADAR_AI_API_KEY=
RADAR_AI_BASE_URL=https://api.deepseek.com
RADAR_AI_MODEL=deepseek-flash
# 数据库默认 data/radar.db；测试时指定临时库
# CAREER_HOME=/absolute/path/to/career-assistant
# RADAR_DB_PATH=
# RADAR_DATA_DIR=
# RADAR_CONFIG_PATH=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_SSL=true
SMTP_STARTTLS=false

# 可选课程扩展：默认 sqlite；Kafka 模式由 docker-compose.yml 设置。
# TASK_BACKEND=kafka
# KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
# KAFKA_TASK_TOPIC=career-assistant.tasks
# KAFKA_DLQ_TOPIC=career-assistant.tasks.dlq
# KAFKA_CONSUMER_GROUP=career-assistant-workers
