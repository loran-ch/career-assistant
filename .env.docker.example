# Copy to .env.docker before running Docker Compose. Never commit real secrets.
RADAR_AI_API_KEY=
RADAR_AI_BASE_URL=https://api.deepseek.com
RADAR_AI_MODEL=deepseek-flash

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_SSL=true
SMTP_STARTTLS=false

CAREER_PUBLIC_BASE_URL=http://127.0.0.1:5000
CAREER_WEB_PORT=5000
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TASK_TOPIC=career-assistant.tasks
KAFKA_DLQ_TOPIC=career-assistant.tasks.dlq
KAFKA_CONSUMER_GROUP=career-assistant-workers
